{
  "name": "outsera-qa-automation",
  "private": true,
  "workspaces": [
    "api",
    "e2e",
    "mobile"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "serverest:up": "docker compose up -d --wait serverest",
    "serverest:down": "docker compose down",
    "test:mobile": "npm run test -w mobile",
    "test:api": "npm run test -w api",
    "test:e2e": "npm run test -w e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
